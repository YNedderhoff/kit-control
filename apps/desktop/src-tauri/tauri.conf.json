{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KitControl",
  "version": "0.1.0",
  "identifier": "xyz.nedderhoff.kitcontrol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "KitControl", "width": 1280, "height": 850, "minWidth": 760, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Drum-kit editor with native TD-27 MIDI and a packet emulator",
    "category": "Music",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../../LICENSE": "licenses/LICENSE",
      "../../../NOTICE": "licenses/NOTICE",
      "../../../THIRD_PARTY_RUST.md": "licenses/THIRD_PARTY_RUST.md",
      "../../../THIRD_PARTY_FRONTEND.txt": "licenses/THIRD_PARTY_FRONTEND.txt",
      "../../../third-party/": "licenses/third-party/"
    }
  }
}
